# 換行符號規則。
#
# # 為什麼要 text=auto
#
# git 內部原本混著 CRLF 與 LF，於是換一次寫檔工具就產生「整檔重寫」的
# 假 diff——`d280694` 那次實際只加了 100 行，diff 卻顯示 11526 行變動，
# **真正的改動被蓋掉了**。review 時那種 diff 很危險。
#
# `text=auto` 讓 git **內部一律存 LF**，checkout 時依各人的 core.autocrlf
# 決定工作區的形式。Windows 上照樣是 CRLF，編輯器無感，但 diff 乾淨。
#
# > 這條原本被刻意排除，理由是「會重新正規化所有檔案、生出巨大的假 diff」。
# > 2026-09-03 加上去之前先實測了 `git add --renormalize .`——**只影響
# > .gitattributes 自己**，因為 git 內部此時已經全是 LF 了。當初那個顧慮
# > 是對的，只是前提已經不成立。

* text=auto

# 二進位檔不要被當成文字——被換行轉換會直接損毀
*.png    binary
*.jpg    binary
*.ico    binary
*.bin    binary
*.af     binary
*.bundle binary
*.zip    binary
*.exe    binary
*.dll    binary
*.pdb    binary
*.ttf    binary
*.otf    binary

# hook 是 shell script，在 Windows 上也是交給 Git for Windows 附的 sh 執行。
# 換行符號若被轉成 CRLF，shebang 那行會變成 `#!/bin/sh\r`，sh 找不到直譯器
# 而失敗。這裡釘死 LF——**放在最後面**，gitattributes 是後面的規則覆蓋前面的。
.githooks/** text eol=lf


# macOS 的建置／安裝腳本，**理由跟上面的 hook 一模一樣**：它們在 Mac 上
# 由 bash 執行，CRLF 會讓 shebang 變成 `#!/usr/bin/env bash` 而找不到
# 直譯器。git 內部本來就存 LF，所以現在不會壞——釘住是為了擋住「在
# Windows 工作區改完直接複製給 Mac」與「有人設了 core.autocrlf=true」
# 這兩條路。
*.sh text eol=lf


# 釘死的上游詞庫原料（2026-09-12 進版控，見 .gitignore 那段說明）：
# **一律 LF**，理由跟上面的腳本不同——這些是從上游原封不動抓下來的
# 檔案，釘住行尾才能跟上游逐位元組比對（「上游是不是又飄了」是要
# 實際 diff 的，行尾差異會把真正的改動蓋掉）。
data/bopomofo/BPMFBase.txt  text eol=lf
data/bopomofo/char_freq.txt text eol=lf
data/bopomofo/zh_tw_50k.txt text eol=lf
data/english/en_50k.txt     text eol=lf

# `gen_reading_freq` 產的讀音別字頻（2026-09-12 進版控，見 .gitignore）。
# 釘 LF 的理由跟上面那批一樣——它是可重現的產物，行尾一飄就會產生
# 整檔的假 diff，真正的改動就被蓋掉了。
# （同批的 `dict_zh.bin` 走 `*.bin binary`，不做換行轉換。）
data/bopomofo/char_freq_by_reading.txt text eol=lf
